{
  "name": "@fanfan4589/dsh-feifan-life",
  "version": "0.2.3",
  "description": "非凡人生个人版 for DSH：复用当前 Obsidian 插件的界面与业务逻辑，数据独立存储。",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "feifandiv",
  "homepage": "https://github.com/feifandiv/dsh-feifan-life#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "feifan-life",
    "life-management"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "node build.mjs typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "lucide": "^1.8.0",
    "playwright-core": "^1.56.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feifandiv/dsh-feifan-life.git"
  },
  "bugs": {
    "url": "https://github.com/feifandiv/dsh-feifan-life/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
